# ---------- Postgres (admin role: setup & migrations only) ----------
# The read-only agent role and the publish/write role are added in Step 2.
POSTGRES_USER=pitwall_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=pitwall
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- LLM providers ----------
ANTHROPIC_API_KEY= 
OPENAI_API_KEY=

# Claude: main model for drafting rulings & answers; fast model for cheap calls/smoke tests
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# OpenAI: embeddings now; judge model is chosen in the judge step
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_JUDGE_MODEL=

# ---------- LangSmith (wired up in a later step) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pitwall

